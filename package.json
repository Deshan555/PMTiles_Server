{
  "name": "pmtiles-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "dev:tsx": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:cluster": "WORKERS=0 node dist/index.js",
    "monitor:up": "docker compose -f docker-compose.monitoring.yml up -d",
    "monitor:down": "docker compose -f docker-compose.monitoring.yml down",
    "monitor:logs": "docker compose -f docker-compose.monitoring.yml logs -f",
    "perf:quick": "node tests/perf/run-suite.mjs quick",
    "perf:load": "node tests/perf/run-suite.mjs load",
    "perf:all": "node tests/perf/run-suite.mjs all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-status-monitor": "^1.3.4",
    "mime-types": "^3.0.2",
    "pbf": "^5.1.0",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/express-status-monitor": "^1.3.3",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.10.1",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
